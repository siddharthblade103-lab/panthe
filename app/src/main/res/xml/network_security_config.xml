<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce strict HTTPS/TLS across all network traffic; block cleartext HTTP data leaks -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
